  {
    "id": "REG-BID-0010",
    "type": "regulation",
    "law_name": "中华人民共和国招标投标法实施条例",
    "law_short": "招标投标法实施条例",
    "law_level": "行政法规",
    "article": "第四十条",
    "content": "有下列情形之一的，视为投标人相互串通投标：（一）不同投标人的投标文件由同一单位或者个人编制；（二）不同投标人委托同一单位或者个人办理投标事宜；（三）不同投标人的投标文件载明的项目管理成员为同一人；（四）不同投标人的投标文件异常一致或者投标报价呈规律性差异；（五）不同投标人的投标文件相互混装；（六）不同投标人的投标保证金从同一单位或者个人的账户转出。",
    "key_point": "六种'视为串标'情形：同人编制、同人办理、同一项目成员、异常一致、相互混装、同保证金账户",
    "applicable_scenario": [
      "串标判定",
      "投标文件同源检测",
      "报价规律性差异",
      "保证金溯源"
    ],
    "violation_consequence": "中标无效+罚款+取消投标资格+刑事责任",
    "penalty_range": "中标项目金额5‰-10‰罚款",
