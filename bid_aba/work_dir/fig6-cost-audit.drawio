    <mxCell id="t" value="&lt;b&gt;工程造价审核流程与要点图&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#2C3E50;" parent="1" vertex="1">
