    <!-- Vertices -->
    <mxCell id="s1" value="&lt;b&gt;第一阶段：准备阶段&lt;/b&gt;&lt;br&gt;(5个工作日)&lt;br&gt;&lt;br&gt;• 收集项目基本资料&lt;br&gt;• 了解项目建设管理情况&lt;br&gt;• 制定审核方案&lt;br&gt;• 风险评估与分工&lt;br&gt;• 发出审核通知" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8E44AD;strokeColor=#6C3483;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="50" y="60" width="240" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="s2" value="&lt;b&gt;第二阶段：实施阶段&lt;/b&gt;&lt;br&gt;(30-45个工作日)&lt;br&gt;&lt;br&gt;• 召开进点会&lt;br&gt;• 查阅账簿凭证&lt;br&gt;• 查阅工程资料&lt;br&gt;• 现场核实核实&lt;br&gt;• 专项审核" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2980B9;strokeColor=#1F618D;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="320" y="60" width="240" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="s3" value="&lt;b&gt;第三阶段：报告阶段&lt;/b&gt;&lt;br&gt;(10个工作日)&lt;br&gt;&lt;br&gt;• 报告撰写&lt;br&gt;• 三级复核&lt;br&gt;• 征求意见&lt;br&gt;• 审批出具&lt;br&gt;• 成果归档" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27AE60;strokeColor=#1E8449;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="590" y="60" width="240" height="150" as="geometry"/>
    </mxCell>
    
    <!-- Detailed sub-steps -->
    <mxCell id="s4" value="&lt;b&gt;审核重点领域&lt;/b&gt;&lt;br&gt;&lt;br&gt;🔍 建设成本核算审核&lt;br&gt;   - 是否超批准建设内容支出&lt;br&gt;   - 成本归集是否准确&lt;br&gt;🔍 支出合规性审核&lt;br&gt;   - 合同协议执行情况&lt;br&gt;   - 非法收费与摊派排查&lt;br&gt;🔍 票据合规性审核&lt;br&gt;   - 发票项目完整性&lt;br&gt;   - 审批手续与签字&lt;br&gt;🔍 损失浪费审核&lt;br&gt;   - 工程报废损失责任划分" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E74C3C;strokeColor=#C0392B;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="50" y="300" width="360" height="200" as="geometry"/>
    </mxCell>
    
    <mxCell id="s5" value="&lt;b&gt;审核方法矩阵&lt;/b&gt;&lt;br&gt;&lt;br&gt;📊 全面核查法 - 资料系统查阅&lt;br&gt;📊 数据分析法 - 异常数据识别&lt;br&gt;📊 现场核实法 - 实查盘点&lt;br&gt;📊 函证询证法 - 外部核实&lt;br&gt;📊 专家咨询法 - 专业问题咨询&lt;br&gt;📊 穿行测试法 - 流程追踪&lt;br&gt;📊 符合性测试 - 内控评价&lt;br&gt;📊 实质性测试 - 金额真实性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F39C12;strokeColor=#D68910;fontColor=#2C3E50;fontFamily=Microsoft YaHei;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="440" y="300" width="260" height="200" as="geometry"/>
    </mxCell>
    
    <mxCell id="s6" value="&lt;b&gt;成果输出&lt;/b&gt;&lt;br&gt;&lt;br&gt;📄 竣工财务决算审核报告&lt;br&gt;📄 审核工作底稿&lt;br&gt;📄 管理建议书&lt;br&gt;📄 审核日志&lt;br&gt;📄 电子版成果（PDF+WORD）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1ABC9C;strokeColor=#17A589;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="730" y="300" width="200" height="200" as="geometry"/>
    </mxCell>
    
