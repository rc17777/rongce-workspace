<mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    
    <mxCell id="title" value="&lt;b&gt;三级复核质量控制体系流程图&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#2C3E50;" vertex="1" parent="1">
      <mxGeometry x="250" y="10" width="300" height="30" as="geometry"/>
    </mxCell>
    
    <!-- Flow: Left to right, three stages -->
    <mxCell id="l1" value="&lt;b&gt;一级复核&lt;/b&gt;&lt;br&gt;&lt;br&gt;复核人：项目组内交叉复核&lt;br&gt;&lt;br&gt;复核内容：&lt;br&gt;• 底稿完整性检查&lt;br&gt;• 数据准确性核对&lt;br&gt;• 证据充分性判断&lt;br&gt;&lt;br&gt;时限：3个工作日" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27AE60;strokeColor=#1E8449;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="50" y="80" width="220" height="180" as="geometry"/>
    </mxCell>
    <mxCell id="l2" value="&lt;b&gt;二级复核&lt;/b&gt;&lt;br&gt;&lt;br&gt;复核人：质量控制部&lt;br&gt;&lt;br&gt;复核内容：&lt;br&gt;• 政策法规运用&lt;br&gt;• 重大事项判断&lt;br&gt;• 审计结论合理性&lt;br&gt;• 征求意见稿审核&lt;br&gt;&lt;br&gt;时限：5个工作日" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F39C12;strokeColor=#D68910;fontColor=#2C3E50;fontFamily=Microsoft YaHei;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="340" y="80" width="220" height="180" as="geometry"/>
    </mxCell>
    <mxCell id="l3" value="&lt;b&gt;三级复核&lt;/b&gt;&lt;br&gt;&lt;br&gt;复核人：技术负责人/项目负责人&lt;br&gt;&lt;br&gt;复核内容：&lt;br&gt;• 最终报告审定&lt;br&gt;• 重大问题集体决策&lt;br&gt;• 报告签发审批&lt;br&gt;&lt;br&gt;时限：2个工作日" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E74C3C;strokeColor=#C0392B;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="630" y="80" width="220" height="180" as="geometry"/>
    </mxCell>
    
    <!-- Edges -->
    <mxCell id="q1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#27AE60;strokeWidth=3;" edge="1" parent="1" source="l1" target="l2">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="q2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F39C12;strokeWidth=3;" edge="1" parent="1" source="l2" target="l3">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Rejection feedback -->
    <mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E74C3C;strokeWidth=2;dashed=1;" edge="1" parent="1" source="l2" target="l1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="450" y="300"/>
          <mxPoint x="160" y="300"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E74C3C;strokeWidth=2;dashed=1;" edge="1" parent="1" source="l3" target="l2">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="740" y="320"/>
          <mxPoint x="450" y="320"/>
        </Array>
      </mxGeometry>
    </mxCell>
    
    <!-- Labels for rejections -->
    <mxCell id="rl1" value="退回修改" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#E74C3C;" vertex="1" parent="1">
      <mxGeometry x="280" y="295" width="70" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="rl2" value="退回修改" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#E74C3C;" vertex="1" parent="1">
      <mxGeometry x="580" y="315" width="70" height="20" as="geometry"/>
    </mxCell>
    
    <!-- Output -->
    <mxCell id="out" value="&lt;b&gt;最终输出&lt;/b&gt;&lt;br&gt;&lt;br&gt;✅ 经三级复核合格的&lt;br&gt;审核报告正式出具&lt;br&gt;✅ 工作底稿归档&lt;br&gt;✅ 成果交付委托方" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1ABC9C;strokeColor=#17A589;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="630" y="310" width="220" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="q3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1ABC9C;strokeWidth=3;" edge="1" parent="1" source="l3" target="out">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
