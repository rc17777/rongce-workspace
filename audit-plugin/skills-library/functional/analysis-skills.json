{
  "tier": "functional",
  "category": "分析与报告",
  "skills": [
    {
      "id": "func-cross-validation",
      "name": "多源数据交叉验证",
      "goal": "对比不同来源数据（财务/业务/外部），识别矛盾和不一致点",
      "inputs": ["财务数据", "业务数据", "外部数据(税务/社保)", "非结构化文本"],
      "outputs": ["数据对齐报告", "矛盾点清单"],
      "typical_time_hours": {"min": 4, "max": 16},
      "sequence": [
        {"step": 1, "action": "建立主键映射 → 原子:field-mapping"},
        {"step": 2, "action": "金额维度交叉比对（多源同一业务金额是否一致）"},
        {"step": 3, "action": "时间维度交叉比对（业务发生时间vs入账时间合理性）"},
        {"step": 4, "action": "逻辑验证（如：人数×人均经费vs总经费的一致性）"},
        {"step": 5, "action": "按严重程度排序输出矛盾点清单"}
      ],
      "atomic_skills": ["atom-field-mapping", "atom-correlation"],
      "applicable_audit_types": ["ALL"]
    },
    {
      "id": "func-depreciation-recalc",
      "name": "折旧重计算与减值评估",
      "goal": "独立重算固定资产折旧，评估减值风险",
      "inputs": ["资产台账", "折旧政策", "使用状况"],
      "outputs": ["折旧差异表", "少提/多提折旧影响金额", "减值风险资产清单"],
      "typical_time_hours": {"min": 3, "max": 8},
      "sequence": [
        {"step": 1, "action": "确认折旧政策（年限/残值/方法）"},
        {"step": 2, "action": "逐项重算：入账日到审计基准日的应提折旧"},
        {"step": 3, "action": "对比账面vs应提折旧差异"},
        {"step": 4, "action": "标记减值信号：已提完折旧仍在使用、长期闲置、技术淘汰"}
      ],
      "atomic_skills": ["atom-field-mapping", "atom-outlier-detect"],
      "applicable_audit_types": ["资产清查", "内控审计"]
    },
    {
      "id": "func-finding-generator",
      "name": "审计发现问题生成",
      "goal": "从分析结果中系统提炼审计发现，确保每个问题有明确的政策依据",
      "inputs": ["分析底稿", "政策知识库", "异常数据标记"],
      "outputs": ["问题清单（含等级/类别/依据）", "问题证据索引"],
      "typical_time_hours": {"min": 4, "max": 12},
      "sequence": [
        {"step": 1, "action": "汇总所有异常标记和分析发现"},
        {"step": 2, "action": "逐条匹配政策依据 → 原子:policy-match"},
        {"step": 3, "action": "判定问题等级 → 原子:severity-classify"},
        {"step": 4, "action": "去重合并：同一根因的不同表现合并"},
        {"step": 5, "action": "按重要性排序，建立问题→证据→建议交叉索引"}
      ],
      "atomic_skills": ["atom-policy-match", "atom-severity-classify"],
      "applicable_audit_types": ["ALL"]
    },
    {
      "id": "func-recommendation",
      "name": "可落地审计建议生成",
      "goal": "针对每个审计发现，生成SMART原则的可执行改进建议",
      "inputs": ["问题清单", "被审计单位组织架构"],
      "outputs": ["建议清单（含责任主体/时限/验收标准）"],
      "typical_time_hours": {"min": 3, "max": 8},
      "sequence": [
        {"step": 1, "action": "逐条分析制度性根因 → 原子:root-cause"},
        {"step": 2, "action": "生成SMART建议 → 原子:feasibility"},
        {"step": 3, "action": "指定责任主体（具体到部门/岗位）"},
        {"step": 4, "action": "给出时限和验收标准"},
        {"step": 5, "action": "区分立行立改vs逐步改进"}
      ],
      "atomic_skills": ["atom-root-cause", "atom-feasibility"],
      "applicable_audit_types": ["ALL"]
    },
    {
      "id": "func-report-generation",
      "name": "审计报告自动生成",
      "goal": "基于底稿和问题清单，按标准模板生成完整审计报告草稿",
      "inputs": ["审计底稿", "问题清单", "建议清单", "项目元信息"],
      "outputs": ["审计报告草稿(DRAFT)"],
      "typical_time_hours": {"min": 4, "max": 16},
      "sequence": [
        {"step": 1, "action": "填充基本信息（单位/期间/目标）"},
        {"step": 2, "action": "生成审计概况（范围+方法+抽样+限制）"},
        {"step": 3, "action": "逐条生成问题段落（事实→政策依据→影响分析）"},
        {"step": 4, "action": "生成建议段落（对应每条问题）"},
        {"step": 5, "action": "生成结论与总体评价"},
        {"step": 6, "action": "标注DRAFT标记+来源引用"}
      ],
      "atomic_skills": ["atom-policy-match"],
      "applicable_audit_types": ["ALL"]
    }
  ]
}
