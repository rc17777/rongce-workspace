{
  "tier": "functional",
  "category": "现场审计程序",
  "skills": [
    {
      "id": "func-voucher-sampling",
      "name": "凭证抽样检查",
      "goal": "按科学抽样方法抽取凭证，检查其真实性、完整性和合规性，推算总体误差率",
      "inputs": ["序时账", "凭证附件", "审批单据"],
      "outputs": ["抽样清单", "凭证检查底稿", "异常凭证清单", "总体误差推算"],
      "typical_time_hours": {"min": 8, "max": 24},
      "sequence": [
        {"step": 1, "action": "确定抽样方法和样本量 → 原子:stratified-sampling / atom:mus"},
        {"step": 2, "action": "执行抽样，输出样本清单"},
        {"step": 3, "action": "逐笔检查：审批→票据→用途→金额 → 原子:voucher-inspect"},
        {"step": 4, "action": "记录异常项，分类汇总"},
        {"step": 5, "action": "推算总体误差率，判断可接受性"}
      ],
      "atomic_skills": ["atom-stratified-sampling", "atom-mus", "atom-voucher-inspect"],
      "applicable_audit_types": ["ALL"]
    },
    {
      "id": "func-physical-verification",
      "name": "实地核查与资产盘点",
      "goal": "按抽样方案实地核实资产/存货的存在性、完整性、使用状况",
      "inputs": ["资产/存货台账", "盘点方案", "实物核查表"],
      "outputs": ["盘点差异表", "盘盈盘亏清单", "使用状况评估"],
      "typical_time_hours": {"min": 8, "max": 40},
      "sequence": [
        {"step": 1, "action": "设计分层抽样：按金额/年限/类型分3-5层 → 原子:stratified-sampling"},
        {"step": 2, "action": "生成盘点清单，明确核查对象"},
        {"step": 3, "action": "实地逐项核对：标签、型号、存放地、使用状态"},
        {"step": 4, "action": "差异记录：盘盈/盘亏/信息不符，现场拍照取证"},
        {"step": 5, "action": "按原因分类汇总：正常损耗/管理不善/账务差错/资产流失"}
      ],
      "atomic_skills": ["atom-stratified-sampling"],
      "applicable_audit_types": ["资产清查", "内控审计"]
    },
    {
      "id": "func-fund-flow-trace",
      "name": "资金流向全链路追踪",
      "goal": "追踪特定资金从来源到最终去向，识别挪用、截留、滞留",
      "inputs": ["专项资金台账", "银行流水", "项目进度报告"],
      "outputs": ["资金流向图谱", "异常流向清单", "进度-资金匹配分析"],
      "typical_time_hours": {"min": 8, "max": 24},
      "sequence": [
        {"step": 1, "action": "提取资金台账，建立逐笔追踪基线"},
        {"step": 2, "action": "银行流水双向对账 → 原子:bank-reconciliation"},
        {"step": 3, "action": "逐笔追踪资金去向：收款方/用途/时间"},
        {"step": 4, "action": "进度-资金匹配分析 → 原子:progress-match"},
        {"step": 5, "action": "标注异常：挪用、滞留、预付比例过高、关联方收款"}
      ],
      "atomic_skills": ["atom-bank-reconciliation", "atom-progress-match"],
      "applicable_audit_types": ["专项债审计", "绩效评价", "监督检查"]
    },
    {
      "id": "func-procurement-compliance",
      "name": "采购全流程合规检查",
      "goal": "系统检查采购方式选择→公告→评审→合同→验收的全流程合规性",
      "inputs": ["采购台账", "招标/投标/评标文件", "合同台账"],
      "outputs": ["程序合规性矩阵", "违规事项清单", "化整为零分析"],
      "typical_time_hours": {"min": 8, "max": 24},
      "sequence": [
        {"step": 1, "action": "按金额自动分级筛选 → 原子:threshold-filter"},
        {"step": 2, "action": "化整为零检测 → 原子:split-detect"},
        {"step": 3, "action": "检查采购方式选择合规性"},
        {"step": 4, "action": "公告/备案/中小企业预留政策检查"},
        {"step": 5, "action": "供应商关联分析 → 原子:entity-linkage → 原子:network-analysis"}
      ],
      "atomic_skills": ["atom-threshold-filter", "atom-split-detect", "atom-entity-linkage", "atom-network-analysis"],
      "applicable_audit_types": ["监督检查", "内控审计"]
    },
    {
      "id": "func-contract-lifecycle",
      "name": "合同全生命周期检查",
      "goal": "检查从签订→公告→备案→变更→付款→验收的合同全生命周期合规性",
      "inputs": ["合同台账", "中标通知书", "付款记录", "验收报告"],
      "outputs": ["合同合规性矩阵", "超期/超付/未公告问题清单"],
      "typical_time_hours": {"min": 4, "max": 12},
      "sequence": [
        {"step": 1, "action": "签订时效：中标后30日内签订？"},
        {"step": 2, "action": "公告备案：签订后2工作日公告、7工作日备案？"},
        {"step": 3, "action": "变更合规：补充合同≤原合同10%？有无擅自变更？"},
        {"step": 4, "action": "付款检查：收票后10工作日支付？是否超进度/超金额？"},
        {"step": 5, "action": "验收检查：验收组≥3人单数？书面验收报告？"}
      ],
      "atomic_skills": ["atom-voucher-inspect", "atom-progress-match"],
      "applicable_audit_types": ["监督检查", "内控审计"]
    },
    {
      "id": "func-three-importances-one-big",
      "name": "三重一大决策程序检查",
      "goal": "验证重大事项决策（大额支出/重大采购/重大工程/重要人事）的集体决策程序合规性",
      "inputs": ["会议纪要", "大额支出/采购/工程/人事清单"],
      "outputs": ["决策程序合规矩阵", "决策缺失事项清单"],
      "typical_time_hours": {"min": 4, "max": 12},
      "sequence": [
        {"step": 1, "action": "金额过滤 → 原子:threshold-filter（5万以上支出/50万以上采购/100万以上工程）"},
        {"step": 2, "action": "逐项追溯会议纪要和审批记录"},
        {"step": 3, "action": "法定人数：到会成员≥2/3？"},
        {"step": 4, "action": "议程合规：有会前议题准备？无临时动议？"},
        {"step": 5, "action": "表决记录完整？"}
      ],
      "atomic_skills": ["atom-threshold-filter"],
      "applicable_audit_types": ["ALL"]
    }
  ]
}
