[
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"附录十五：审核人员培训计划","style":"Heading1"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"审核人员培训计划","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"项目名称：2026年阿坝州财政局州本级建设项目竣工财务决算审核项目","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"培训目标：提高审核人员专业素质，确保审核工作质量","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"培训对象：项目总监、项目经理、项目执行层全体人员","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"培训时间：准备阶段第3-4个工作日","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"培训地点：四川融策会计师事务所培训室","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"培训内容：","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"（一）项目背景培训。介绍阿坝州地理环境、民族特点、建设项目特点，使审核人员了解项目背景。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"（二）法规培训。讲解《基本建设财务规则》《基本建设项目竣工财务决算管理暂行办法》等法规，使审核人员掌握审核依据。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"（三）技术培训。讲解高原施工增加费计算、自然灾害损失认定、民族地区政策适用等技术问题，使审核人员掌握审核技术。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"（四）保密培训。讲解保密制度、保密责任、保密措施，使审核人员树立保密意识。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"培训考核：培训结束后进行考核，考核合格后方可参与审核工作。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"培训记录：培训记录保存备查。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"附录十六：审核工作纪律规定","style":"Heading1"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"审核工作纪律规定","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"项目名称：2026年阿坝州财政局州本级建设项目竣工财务决算审核项目","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"一、廉洁纪律","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"（一）不得接受被审计单位的宴请、礼品、礼金。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"（二）不得在被审计单位报销任何费用。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"（三）不得利用职务之便为本人或他人谋取私利。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"（四）不得泄露审核过程中知悉的商业秘密。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"二、工作纪律","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"（一）严格遵守审核方案，不得擅自变更审核范围、审核程序、审核方法。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"（二）严格遵守工作进度，不得拖延审核工作。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"（三）严格遵守工作质量要求，不得降低审核标准。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"（四）严格遵守工作底稿规范，不得遗漏审核证据。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"三、保密纪律","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"（一）严格遵守保密制度，不得泄露审核信息。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"（二）严格遵守资料管理规定，不得擅自复制、传播审核资料。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"（三）严格遵守信息传输规定，不得通过非加密渠道传输审核信息。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"（四）严格遵守资料销毁规定，不得擅自销毁审核资料。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"四、违规处理","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"（一）违反廉洁纪律的，取消审核资格，追究法律责任。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"（二）违反工作纪律的，责令改正，情节严重的取消审核资格。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"（三）违反保密纪律的，取消审核资格，追究法律责任。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"（四）构成犯罪的，移送司法机关处理。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"附录十七：审核工作质量承诺书","style":"Heading1"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"审核工作质量承诺书","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"项目名称：2026年阿坝州财政局州本级建设项目竣工财务决算审核项目","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"承诺单位：四川融策会计师事务所","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"我单位郑重承诺：","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"一、严格按照比选文件要求和国家相关法律法规开展审核工作，确保审核结论客观、公正、准确。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"二、配备经验丰富的注册会计师、造价工程师组成的专业审核团队，必要时聘请民族地区政策专家、自然灾害领域专家参与。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"三、在合同约定的服务期限内完成全部审核工作，确保审核报告质量符合财政部《基本建设项目竣工财务决算管理暂行办法》要求。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"四、严格遵守保密规定，对审核过程中知悉的被审计单位商业秘密、财务数据等严格保密。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"五、如审核工作出现质量问题，愿意承担相应的法律责任和经济赔偿责任。","style":"Normal"}},
  {"command":"add","parent":"/body","type":"paragraph","props":{"text":"承诺单位（盖章）：四川融策会计师事务所","style":"Normal"}},
